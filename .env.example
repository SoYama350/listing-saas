# ── App ────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./listingsaas.db
BASE_URL=http://localhost:8000

# ── Telegram ───────────────────────────────────────────
# Get from @BotFather
TELEGRAM_BOT_TOKEN=

# ── LLM (OpenRouter) ───────────────────────────────────
# Free models work, e.g. google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── Encrypted store for customer creds ─────────────────
# 32 url-safe base64 bytes:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Owner (your Telegram id, optional, for admin) ──────
OWNER_TELEGRAM_ID=
